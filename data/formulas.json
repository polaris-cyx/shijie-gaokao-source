{
  "items": [
    { "id": "F-M-001", "subject": "math", "chapter": "M01", "name": "子集个数", "expr": "含 n 个元素的集合有 2^n 个子集，2^n - 1 个真子集", "note": "非空真子集为 2^n - 2", "tags": ["集合"] },
    { "id": "F-M-002", "subject": "math", "chapter": "M01", "name": "容斥原理", "expr": "card(A∪B) = card(A) + card(B) - card(A∩B)", "note": "三个集合类似展开", "tags": ["集合"] },
    { "id": "F-M-003", "subject": "math", "chapter": "M01", "name": "充分必要", "expr": "P ⊆ Q ⇔ p 是 q 的充分条件", "note": "小范围推大范围", "tags": ["逻辑"] },
    { "id": "F-M-004", "subject": "math", "chapter": "M02", "name": "基本不等式", "expr": "a + b ≥ 2sqrt{ab}（a>0，b>0）", "note": "当且仅当 a=b 时取等", "tags": ["不等式", "必背"] },
    { "id": "F-M-005", "subject": "math", "chapter": "M02", "name": "积定和最小", "expr": "ab ≤ frac{(a+b)^2}{4}", "note": "和定积最大", "tags": ["不等式"] },
    { "id": "F-M-006", "subject": "math", "chapter": "M02", "name": "均值不等式链", "expr": "frac{2}{frac{1}{a}+frac{1}{b}} ≤ sqrt{ab} ≤ frac{a+b}{2} ≤ sqrt{frac{a^2+b^2}{2}}", "note": "a,b>0，等号同时成立", "tags": ["不等式"] },
    { "id": "F-M-007", "subject": "math", "chapter": "M02", "name": "一元二次不等式", "expr": "ax^2+bx+c>0（a>0），Δ>0 时解集在两根之外", "note": "大于取两边，小于取中间", "tags": ["不等式"] },
    { "id": "F-M-008", "subject": "math", "chapter": "M02", "name": "求根公式", "expr": "x = frac{-b ± sqrt{b^2-4ac}}{2a}", "note": "Δ = b²-4ac", "tags": ["不等式", "二次"] },
    { "id": "F-M-009", "subject": "math", "chapter": "M03", "name": "二次函数顶点", "expr": "(-frac{b}{2a}, frac{4ac-b^2}{4a})", "note": "对称轴 x = -b/2a", "tags": ["函数"] },
    { "id": "F-M-010", "subject": "math", "chapter": "M03", "name": "韦达定理", "expr": "x_1+x_2 = -frac{b}{a}，x_1x_2 = frac{c}{a}", "note": "方程 ax²+bx+c=0", "tags": ["函数", "二次"] },
    { "id": "F-M-011", "subject": "math", "chapter": "M03", "name": "指数运算法则", "expr": "a^m·a^n = a^{m+n}，(a^m)^n = a^{mn}，a^{-n} = frac{1}{a^n}", "note": "a>0", "tags": ["指数"] },
    { "id": "F-M-012", "subject": "math", "chapter": "M03", "name": "对数运算法则", "expr": "log_a(MN) = log_a M + log_a N", "note": "真数大于 0", "tags": ["对数"] },
    { "id": "F-M-013", "subject": "math", "chapter": "M03", "name": "换底公式", "expr": "log_a b = frac{log_c b}{log_c a}", "note": "c>0 且 c≠1", "tags": ["对数"] },
    { "id": "F-M-014", "subject": "math", "chapter": "M03", "name": "零点存在定理", "expr": "f(a)f(b) < 0 且 f 连续 ⇒ 存在 x_0∈(a,b)，f(x_0)=0", "note": "连续 + 单调可保证唯一", "tags": ["函数", "零点"] },
    { "id": "F-M-015", "subject": "math", "chapter": "M04", "name": "导数定义", "expr": "f'(x_0) = lim_{Δx→0} frac{f(x_0+Δx)-f(x_0)}{Δx}", "note": "瞬时变化率", "tags": ["导数"] },
    { "id": "F-M-016", "subject": "math", "chapter": "M04", "name": "幂函数求导", "expr": "(x^n)' = nx^{n-1}", "note": "n 为实数", "tags": ["导数", "必背"] },
    { "id": "F-M-017", "subject": "math", "chapter": "M04", "name": "指数对数求导", "expr": "(e^x)' = e^x，(ln x)' = frac{1}{x}", "note": "(a^x)' = a^x ln a", "tags": ["导数"] },
    { "id": "F-M-018", "subject": "math", "chapter": "M04", "name": "乘积与商求导", "expr": "(uv)' = u'v + uv'，(frac{u}{v})' = frac{u'v-uv'}{v^2}", "note": "商的分子顺序不能反", "tags": ["导数"] },
    { "id": "F-M-019", "subject": "math", "chapter": "M04", "name": "链式法则", "expr": "[f(g(x))]' = f'(g(x))·g'(x)", "note": "由外向内逐层求导", "tags": ["导数"] },
    { "id": "F-M-020", "subject": "math", "chapter": "M04", "name": "切线方程", "expr": "y - f(x_0) = f'(x_0)(x - x_0)", "note": "在点 (x₀,f(x₀)) 处", "tags": ["导数", "切线"] },
    { "id": "F-M-021", "subject": "math", "chapter": "M05", "name": "弧度与角度", "expr": "180° = π，l = abs{α}r，S = frac{1}{2}abs{α}r^2", "note": "α 用弧度", "tags": ["三角"] },
    { "id": "F-M-022", "subject": "math", "chapter": "M05", "name": "同角关系", "expr": "sin^2α + cos^2α = 1，tan α = frac{sin α}{cos α}", "note": "开方看象限", "tags": ["三角", "必背"] },
    { "id": "F-M-023", "subject": "math", "chapter": "M05", "name": "诱导公式", "expr": "sin(π-α)=sin α，cos(π-α)=-cos α", "note": "奇变偶不变，符号看象限", "tags": ["三角"] },
    { "id": "F-M-024", "subject": "math", "chapter": "M05", "name": "两角和差", "expr": "sin(α±β)=sin α cos β ± cos α sin β", "note": "余弦中间符号相反", "tags": ["三角", "必背"] },
    { "id": "F-M-025", "subject": "math", "chapter": "M05", "name": "二倍角", "expr": "sin 2α = 2sin α cos α，cos 2α = 2cos^2α - 1", "note": "降幂：cos²α=(1+cos2α)/2", "tags": ["三角", "必背"] },
    { "id": "F-M-026", "subject": "math", "chapter": "M05", "name": "辅助角", "expr": "a sin x + b cos x = sqrt{a^2+b^2} sin(x+φ)", "note": "tan φ = b/a", "tags": ["三角"] },
    { "id": "F-M-027", "subject": "math", "chapter": "M05", "name": "正弦定理", "expr": "frac{a}{sin A} = frac{b}{sin B} = frac{c}{sin C} = 2R", "note": "边角互化", "tags": ["解三角形", "必背"] },
    { "id": "F-M-028", "subject": "math", "chapter": "M05", "name": "余弦定理", "expr": "a^2 = b^2 + c^2 - 2bc cos A", "note": "已知三边求角", "tags": ["解三角形", "必背"] },
    { "id": "F-M-029", "subject": "math", "chapter": "M05", "name": "三角形面积", "expr": "S = frac{1}{2}ab sin C", "note": "三组边角任选", "tags": ["解三角形"] },
    { "id": "F-M-030", "subject": "math", "chapter": "M06", "name": "等差数列通项", "expr": "a_n = a_1 + (n-1)d", "note": "关于 n 的一次函数", "tags": ["数列", "必背"] },
    { "id": "F-M-031", "subject": "math", "chapter": "M06", "name": "等差数列求和", "expr": "S_n = frac{n(a_1+a_n)}{2} = na_1 + frac{n(n-1)}{2}d", "note": "常数项为 0 的二次函数", "tags": ["数列", "必背"] },
    { "id": "F-M-032", "subject": "math", "chapter": "M06", "name": "等比数列通项", "expr": "a_n = a_1 q^{n-1}", "note": "q≠0", "tags": ["数列", "必背"] },
    { "id": "F-M-033", "subject": "math", "chapter": "M06", "name": "等比数列求和", "expr": "S_n = frac{a_1(1-q^n)}{1-q}（q≠1）", "note": "q=1 时 Sₙ=na₁", "tags": ["数列", "必背"] },
    { "id": "F-M-034", "subject": "math", "chapter": "M06", "name": "裂项相消", "expr": "frac{1}{n(n+1)} = frac{1}{n} - frac{1}{n+1}", "note": "注意系数", "tags": ["数列"] },
    { "id": "F-M-035", "subject": "math", "chapter": "M07", "name": "柱锥台球体积", "expr": "V_{柱}=Sh，V_{锥}=frac{1}{3}Sh，V_{球}=frac{4}{3}πR^3", "note": "台体 1/3 h(S₁+√(S₁S₂)+S₂)", "tags": ["立体几何", "必背"] },
    { "id": "F-M-036", "subject": "math", "chapter": "M07", "name": "球的表面积", "expr": "S = 4πR^2", "note": "与体积区分", "tags": ["立体几何"] },
    { "id": "F-M-037", "subject": "math", "chapter": "M07", "name": "线面平行判定", "expr": "a ∥ b，b ⊂ α，a ⊄ α ⇒ a ∥ α", "note": "平面内找平行线", "tags": ["立体几何"] },
    { "id": "F-M-038", "subject": "math", "chapter": "M07", "name": "线面垂直判定", "expr": "l ⊥ a，l ⊥ b，a∩b=P ⇒ l ⊥ α", "note": "两条相交直线", "tags": ["立体几何", "必背"] },
    { "id": "F-M-039", "subject": "math", "chapter": "M07", "name": "线线角公式", "expr": "cos θ = frac{abs{a·b}}{abs{a}abs{b}}", "note": "范围 [0,π/2]", "tags": ["空间向量"] },
    { "id": "F-M-040", "subject": "math", "chapter": "M07", "name": "线面角公式", "expr": "sin θ = frac{abs{a·n}}{abs{a}abs{n}}", "note": "不是余弦", "tags": ["空间向量"] },
    { "id": "F-M-041", "subject": "math", "chapter": "M07", "name": "点面距", "expr": "d = frac{abs{AP·n}}{abs{n}}", "note": "n 为平面法向量", "tags": ["空间向量"] },
    { "id": "F-M-042", "subject": "math", "chapter": "M08", "name": "斜率", "expr": "k = tan α = frac{y_2-y_1}{x_2-x_1}", "note": "α≠90°", "tags": ["解析几何"] },
    { "id": "F-M-043", "subject": "math", "chapter": "M08", "name": "点线距", "expr": "d = frac{abs{Ax_0+By_0+C}}{sqrt{A^2+B^2}}", "note": "直线 Ax+By+C=0", "tags": ["解析几何"] },
    { "id": "F-M-044", "subject": "math", "chapter": "M08", "name": "平行线距", "expr": "d = frac{abs{C_1-C_2}}{sqrt{A^2+B^2}}", "note": "系数需一致", "tags": ["解析几何"] },
    { "id": "F-M-045", "subject": "math", "chapter": "M08", "name": "圆的方程", "expr": "(x-a)^2+(y-b)^2 = r^2", "note": "一般式先配方", "tags": ["解析几何", "必背"] },
    { "id": "F-M-046", "subject": "math", "chapter": "M08", "name": "弦长公式", "expr": "l = 2sqrt{r^2-d^2}", "note": "直线与圆", "tags": ["解析几何"] },
    { "id": "F-M-047", "subject": "math", "chapter": "M08", "name": "椭圆", "expr": "frac{x^2}{a^2}+frac{y^2}{b^2}=1，c^2=a^2-b^2，e=frac{c}{a}", "note": "a>b>0", "tags": ["圆锥曲线", "必背"] },
    { "id": "F-M-048", "subject": "math", "chapter": "M08", "name": "双曲线", "expr": "frac{x^2}{a^2}-frac{y^2}{b^2}=1，c^2=a^2+b^2", "note": "渐近线 y=±(b/a)x", "tags": ["圆锥曲线", "必背"] },
    { "id": "F-M-049", "subject": "math", "chapter": "M08", "name": "抛物线", "expr": "y^2 = 2px，焦点 (frac{p}{2},0)", "note": "准线 x=-p/2", "tags": ["圆锥曲线", "必背"] },
    { "id": "F-M-050", "subject": "math", "chapter": "M08", "name": "椭圆弦长", "expr": "abs{AB} = sqrt{1+k^2} abs{x_1-x_2}", "note": "联立后用韦达定理", "tags": ["圆锥曲线"] },
    { "id": "F-M-051", "subject": "math", "chapter": "M09", "name": "排列数", "expr": "A_n^m = frac{n!}{(n-m)!}", "note": "有序", "tags": ["计数", "必背"] },
    { "id": "F-M-052", "subject": "math", "chapter": "M09", "name": "组合数", "expr": "C_n^m = frac{n!}{m!(n-m)!}", "note": "无序", "tags": ["计数", "必背"] },
    { "id": "F-M-053", "subject": "math", "chapter": "M09", "name": "二项式通项", "expr": "T_{k+1} = C_n^k a^{n-k}b^k", "note": "k 从 0 开始", "tags": ["二项式", "必背"] },
    { "id": "F-M-054", "subject": "math", "chapter": "M09", "name": "古典概型", "expr": "P(A) = frac{n(A)}{n(Ω)}", "note": "有限等可能", "tags": ["概率"] },
    { "id": "F-M-055", "subject": "math", "chapter": "M09", "name": "条件概率", "expr": "P(B|A) = frac{P(AB)}{P(A)}", "note": "独立时 P(AB)=P(A)P(B)", "tags": ["概率"] },
    { "id": "F-M-056", "subject": "math", "chapter": "M09", "name": "期望与方差", "expr": "E(X)=Σx_ip_i，D(X)=Σ(x_i-E(X))^2p_i", "note": "二项分布 E=np，D=np(1-p)", "tags": ["概率统计"] },
    { "id": "F-M-057", "subject": "math", "chapter": "M09", "name": "方差", "expr": "s^2 = frac{1}{n}Σ(x_i-bar{x})^2", "note": "标准差为其算术平方根", "tags": ["统计"] },
    { "id": "F-M-058", "subject": "math", "chapter": "M10", "name": "复数模", "expr": "abs{z} = sqrt{a^2+b^2}，z·bar{z}=abs{z}^2", "note": "z=a+bi", "tags": ["复数"] },
    { "id": "F-M-059", "subject": "math", "chapter": "M10", "name": "复数除法", "expr": "frac{a+bi}{c+di} = frac{(a+bi)(c-di)}{c^2+d^2}", "note": "分母实数化", "tags": ["复数"] },
    { "id": "F-M-060", "subject": "math", "chapter": "M10", "name": "数量积", "expr": "a·b = abs{a}abs{b}cos θ = x_1x_2+y_1y_2", "note": "结果是实数", "tags": ["向量", "必背"] },
    { "id": "F-M-061", "subject": "math", "chapter": "M10", "name": "平行与垂直", "expr": "a∥b ⇔ x_1y_2-x_2y_1=0；a⊥b ⇔ x_1x_2+y_1y_2=0", "note": "坐标判定", "tags": ["向量"] },
    { "id": "F-P-001", "subject": "physics", "chapter": "P01", "name": "平均速度", "expr": "bar{v} = frac{Δx}{Δt}", "note": "位移/时间，矢量", "tags": ["运动学"] },
    { "id": "F-P-002", "subject": "physics", "chapter": "P01", "name": "加速度", "expr": "a = frac{Δv}{Δt} = frac{v-v_0}{t}", "note": "方向与 Δv 相同", "tags": ["运动学", "必背"] },
    { "id": "F-P-003", "subject": "physics", "chapter": "P01", "name": "速度公式", "expr": "v = v_0 + at", "note": "匀变速直线运动", "tags": ["运动学", "必背"] },
    { "id": "F-P-004", "subject": "physics", "chapter": "P01", "name": "位移公式", "expr": "x = v_0t + frac{1}{2}at^2", "note": "注意正方向", "tags": ["运动学", "必背"] },
    { "id": "F-P-005", "subject": "physics", "chapter": "P01", "name": "速度位移公式", "expr": "v^2 - v_0^2 = 2ax", "note": "不含时间", "tags": ["运动学", "必背"] },
    { "id": "F-P-006", "subject": "physics", "chapter": "P01", "name": "中间时刻速度", "expr": "v_{t/2} = frac{v_0+v}{2} = frac{x}{t}", "note": "等于平均速度", "tags": ["运动学"] },
    { "id": "F-P-007", "subject": "physics", "chapter": "P01", "name": "中间位置速度", "expr": "v_{x/2} = sqrt{frac{v_0^2+v^2}{2}}", "note": "大于中间时刻速度", "tags": ["运动学"] },
    { "id": "F-P-008", "subject": "physics", "chapter": "P01", "name": "逐差公式", "expr": "Δx = aT^2", "note": "连续相等时间", "tags": ["运动学", "纸带"] },
    { "id": "F-P-009", "subject": "physics", "chapter": "P01", "name": "自由落体", "expr": "v=gt，h=frac{1}{2}gt^2，v^2=2gh", "note": "初速度为 0", "tags": ["自由落体"] },
    { "id": "F-P-010", "subject": "physics", "chapter": "P01", "name": "竖直上抛", "expr": "v=v_0-gt，h=v_0t-frac{1}{2}gt^2", "note": "向上为正", "tags": ["竖直上抛"] },
    { "id": "F-P-011", "subject": "physics", "chapter": "P01", "name": "上抛最大高度", "expr": "H = frac{v_0^2}{2g}，t_{上} = frac{v_0}{g}", "note": "最高点速度为零", "tags": ["竖直上抛"] },
    { "id": "F-P-012", "subject": "physics", "chapter": "P01", "name": "初速为零比例", "expr": "v_1:v_2:v_3=1:2:3，x_1:x_2:x_3=1:4:9", "note": "等分时间", "tags": ["比例"] },
    { "id": "F-P-013", "subject": "physics", "chapter": "P01", "name": "连续相等时间位移比", "expr": "x_Ⅰ:x_Ⅱ:x_Ⅲ = 1:3:5", "note": "初速度为零", "tags": ["比例"] },
    { "id": "F-P-014", "subject": "physics", "chapter": "P02", "name": "打点计时器周期", "expr": "T = frac{1}{f}，f=50Hz ⇒ T=0.02s", "note": "每 5 个间隔取计数点 T=0.1s", "tags": ["实验"] },
    { "id": "F-P-015", "subject": "physics", "chapter": "P02", "name": "纸带瞬时速度", "expr": "v_n = frac{x_n+x_{n+1}}{2T}", "note": "中间时刻速度", "tags": ["实验", "纸带"] },
    { "id": "F-P-016", "subject": "physics", "chapter": "P02", "name": "逐差法求加速度", "expr": "a = frac{(x_4+x_5+x_6)-(x_1+x_2+x_3)}{9T^2}", "note": "六段纸带", "tags": ["实验", "纸带"] },
    { "id": "F-P-017", "subject": "physics", "chapter": "P02", "name": "光电门测速", "expr": "v = frac{d}{Δt}", "note": "d 为遮光条宽度", "tags": ["实验"] },
    { "id": "F-P-018", "subject": "physics", "chapter": "P02", "name": "v-t 图像", "expr": "斜率 = a，面积 = Δx", "note": "交点表示速度相同", "tags": ["图像"] },
    { "id": "F-P-019", "subject": "physics", "chapter": "P02", "name": "x-t 图像", "expr": "斜率 = v", "note": "交点表示相遇", "tags": ["图像"] },
    { "id": "F-P-020", "subject": "physics", "chapter": "P02", "name": "v²-x 图像", "expr": "斜率 = 2a", "note": "由 v²-v₀²=2ax", "tags": ["图像"] }
  ]
}
